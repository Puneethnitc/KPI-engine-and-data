GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Backend runtime paths. Relative defaults live under backend/runtime/.
KPI_RUNTIME_DIR=
KPI_BACKEND_DB=
KPI_CHROMA_DIR=
KPI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo defaults. These are presentation defaults, not trusted identity claims.
KPI_DEMO_PERSONA=CFO
KPI_DEMO_REGION=North
KPI_DEMO_CATEGORY=Electronics
KPI_DEMO_DATE=2023-07-24

# Optional RAG/LLM provider. Deterministic fallback works without this value.

# Server-side backend endpoint and same-origin browser gateway.
KPI_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=/api/backend

# LLM pricing, used for the "Estimated USD cost" shown in Processing transparency.
# Take the per-million-token prices for GROQ_MODEL from your provider's pricing page.
LLM_INPUT_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_USD_PER_MILLION_TOKENS=
LLM_PRICING_VERSION=
