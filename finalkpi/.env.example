# Backend runtime paths. Relative defaults live under backend/runtime/.
KPI_RUNTIME_DIR=
KPI_BACKEND_DB=
KPI_CHROMA_DIR=
KPI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo defaults. These are presentation defaults, not trusted identity claims.
KPI_DEMO_PERSONA=CFO
KPI_DEMO_REGION=North
KPI_DEMO_CATEGORY=Electronics
KPI_DEMO_DATE=2023-07-24

# Optional RAG/LLM provider. Deterministic fallback works without this value.
OPENAI_API_KEY=

# Frontend service endpoint.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
